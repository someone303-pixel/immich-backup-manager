# Immich Backup Manager - erlaubt dem Service-Benutzer diese Befehle ohne Passwort
your_username ALL=(ALL) NOPASSWD: /usr/bin/mount /dev/sdf2 /mnt/backup
your_username ALL=(ALL) NOPASSWD: /usr/bin/umount /mnt/backup
your_username ALL=(ALL) NOPASSWD: /usr/bin/bash -c echo 1 > /sys/block/sdf/device/delete
your_username ALL=(ALL) NOPASSWD: /usr/bin/bash -c echo '- - -' > /sys/class/scsi_host/*/scan
your_username ALL=(ALL) NOPASSWD: /usr/local/bin/immich-backup.sh
your_username ALL=(ALL) NOPASSWD: /usr/bin/crontab -u root -l
your_username ALL=(ALL) NOPASSWD: /usr/bin/crontab -u root -
your_username ALL=(ALL) NOPASSWD: /bin/mount, /bin/umount, /usr/local/bin/immich-backup.sh, /usr/bin/crontab, /bin/sh
