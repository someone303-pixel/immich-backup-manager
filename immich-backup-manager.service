[Unit]
Description=Immich Backup Manager Web Interface
After=network.target

[Service]
Type=simple
User=your_username
WorkingDirectory=/opt/immich-backup-manager
ExecStart=/usr/bin/python3 /opt/immich-backup-manager/app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
